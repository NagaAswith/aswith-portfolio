# ==============================================================================
# ASWITH PORTFOLIO — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development or configure in your deployment platform (Vercel/AWS/GCP).
# NEVER commit actual credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (REQUIRED IN ALL ENVIRONMENTS)
# ------------------------------------------------------------------------------
# Local Development (SQLite): file:./dev.db
# Production (PostgreSQL): postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=file:./dev.db

# ------------------------------------------------------------------------------
# 2. ADMINISTRATIVE SECURITY & AUTHENTICATION (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Passkey used for admin login (Production MUST override default 'aswith-enter4')
ADMIN_PASSKEY=

# Optional: Pre-hashed bcrypt passkey (takes precedence over ADMIN_PASSKEY if provided)
ADMIN_PASSKEY_HASH=

# JWT signing secret for admin session cookies (REQUIRED IN PRODUCTION; MUST NOT use default)
ADMIN_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. MEDIA UPLOAD LIMITS (OPTIONAL)
# ------------------------------------------------------------------------------
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100

# ------------------------------------------------------------------------------
# 4. CLOUD STORAGE — AWS S3 / CLOUDFLARE R2 / MINIO (OPTIONAL; FALLS BACK TO LOCAL)
# ------------------------------------------------------------------------------
# Required only if using Cloud Object Storage instead of local filesystem
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 4b. SUPABASE CONFIGURATION (POSTGRESQL & SUPABASE STORAGE)
# ------------------------------------------------------------------------------
# Public Supabase Project URL (e.g. https://<project-id>.supabase.co)
SUPABASE_URL=

# Supabase Server-Side Secret API Key (SERVER-SIDE ONLY; NEVER COMMIT TO GIT)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. RATE LIMITING — UPSTASH REDIS REST API (OPTIONAL; FALLS BACK TO IN-MEMORY)
# ------------------------------------------------------------------------------
# Required for multi-instance / serverless production rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 6. EXTERNAL NOTIFICATIONS & INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 7. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
